import java.util.Scanner;
import java.text.DecimalFormat;
import java.io.InputStreamReader;
import java.net.HttpURLConnection;
import java.net.URL;

class CurrencyConverter {
    private static final String API_URL = "https://api.exchangerate-api.com/v4/latest/";
    private static final DecimalFormat df = new DecimalFormat("0.00");

    // Fetch the exchange rate from the API
    public static double fetchExchangeRate(String baseCurrency, String targetCurrency) {
        try {
            String urlStr = API_URL + baseCurrency;
            URL url = new URL(urlStr);
            HttpURLConnection connection = (HttpURLConnection) url.openConnection();
            connection.setRequestMethod("GET");

            if (connection.getResponseCode() == 200) {
                Scanner sc = new Scanner(new InputStreamReader(connection.getInputStream()));
                StringBuilder response = new StringBuilder();
                while (sc.hasNext()) {
                    response.append(sc.nextLine());
                }
                sc.close();

                // Parse the target currency rate from the JSON response
                String json = response.toString();
                int startIndex = json.indexOf("\"" + targetCurrency + "\":") + targetCurrency.length() + 3;
                int endIndex = json.indexOf(",", startIndex);
                if (startIndex > -1 && endIndex > -1) {
                    return Double.parseDouble(json.substring(startIndex, endIndex));
                } else {
                    System.out.println("Error: Target currency not found in API response.");
                }
            } else {
                System.out.println("Error: Unable to fetch exchange rates. Please try again later.");
            }
        } catch (Exception e) {
            System.out.println("Error: " + e.getMessage());
        }
        return -1;
    }

    // Convert the currency
    public static double convertCurrency(double amount, double rate) {
        return amount * rate;
    }
}

public class CurrencyConverterApp {
    private static final DecimalFormat df = new DecimalFormat("0.00");

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        printWelcomeMessage();

        System.out.print("Enter base currency (e.g., USD): ");
        String baseCurrency = scanner.nextLine().toUpperCase();

        System.out.print("Enter target currency (e.g., EUR): ");
        String targetCurrency = scanner.nextLine().toUpperCase();

        System.out.print("Enter amount to convert: ");
        if (!scanner.hasNextDouble()) {
            System.out.println("Error: Invalid amount entered. Please restart the application.");
            return;
        }
        double amount = scanner.nextDouble();

        double exchangeRate = CurrencyConverter.fetchExchangeRate(baseCurrency, targetCurrency);

        if (exchangeRate > 0) {
            double convertedAmount = CurrencyConverter.convertCurrency(amount, exchangeRate);
            printConversionResult(baseCurrency, targetCurrency, amount, exchangeRate, convertedAmount);
        } else {
            System.out.println("Currency conversion failed. Please check the currencies and try again.");
        }

        scanner.close();
    }

    private static void printWelcomeMessage() {
        System.out.println("======================================");
        System.out.println("         Currency Converter           ");
        System.out.println("======================================");
        System.out.println("Convert currencies in real-time!");
        System.out.println("--------------------------------------");
    }

    private static void printConversionResult(String baseCurrency, String targetCurrency, double amount, double rate, double convertedAmount) {
        System.out.println("\n======================================");
        System.out.println("         Conversion Results           ");
        System.out.println("======================================");
        System.out.printf("Base Currency: %s\n", baseCurrency);
        System.out.printf("Target Currency: %s\n", targetCurrency);
        System.out.printf("Amount: %s %s\n", df.format(amount), baseCurrency);
        System.out.printf("Exchange Rate (1 %s = %.4f %s)\n", baseCurrency, rate, targetCurrency);
        System.out.printf("Converted Amount: %s %s\n", df.format(convertedAmount), targetCurrency);
        System.out.println("======================================");
        System.out.println("Thank you for using Currency Converter!");
    }
}
